# Copy this file to .env and fill in the values you need.

# Turns on AI analysis. Get a key at https://console.anthropic.com
# Without it, the app still works in offline keyword mode.
ANTHROPIC_API_KEY=

# Optional: Claude model to use (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Optional: save analysis history in MongoDB (local or MongoDB Atlas).
# Without it, history is kept in memory until the server restarts.
# MONGODB_URI=mongodb://127.0.0.1:27017/cv-matcher

# PORT=5000
